{
  "name": "cabinet-shop",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "create-admin": "npm run admin:bootstrap",
    "integrations:work": "tsx scripts/process-integrations.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "@radix-ui/react-slot": "^1.0.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "next": "^16.2.11",
    "next-auth": "^4.24.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "sharp": "^0.35.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8.5.10",
    "prisma": "^6.19.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "sharp": "$sharp",
    "uuid": "^11.1.1",
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=20.11 <25"
  }
}
