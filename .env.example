# PostgreSQL is mandatory. Production deployments should require TLS at the provider.
DATABASE_URL="postgresql://cabinet_app:replace-me@127.0.0.1:5432/cabinet_shop?schema=public"
NEXTAUTH_URL="http://localhost:3000"
BACKEND_PORT="3001"
FRONTEND_PORT="3000"

# Generate three different values, for example: openssl rand -base64 48
NEXTAUTH_SECRET=""
INTERNAL_API_TOKEN=""
PRIVACY_HASH_SECRET=""

# Optional OpenRouter AI features. AI is disabled when the key is blank.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3-5-sonnet-20241022"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_TIMEOUT_MS="180000"
AI_RATE_LIMIT_PER_HOUR="20"

# Optional internal team notification email (not customer outreach).
RESEND_API_KEY=""
LEAD_NOTIFY_EMAIL=""
RESEND_FROM="Heritage Cabinet & Stone <notifications@example.invalid>"

# Optional bidirectional connectors. The seed creates disabled definitions unless a URL exists.
CRM_SYNC_URL=""
CRM_SYNC_TOKEN=""
EMAIL_SYNC_URL=""
EMAIL_SYNC_TOKEN=""
CALENDAR_SYNC_URL=""
CALENDAR_SYNC_TOKEN=""
ENRICHMENT_SYNC_URL=""
ENRICHMENT_SYNC_TOKEN=""

# Explicit one-time operator actions; never set these in normal application containers.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
RUN_MIGRATIONS="0"
RUN_SEED="0"
