# Same shape as the independentRestaurant app's .env

DATABASE_URL="postgresql://USER@localhost:5432/cabinet_shop_db?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cabinet-shop-dev-secret-change-in-production"

# OpenRouter (for the AI concierge)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3-5-sonnet-20241022"

# Optional: email notifications for new leads/consultations (Resend).
# Leave blank to disable — the site works fine without it.
RESEND_API_KEY=""
LEAD_NOTIFY_EMAIL=""
RESEND_FROM="Heritage Cabinet & Stone <onboarding@resend.dev>"
